# Copy to .env and fill only the CC credential. Never commit .env.
CKFF_CODEX_CC_API_KEY=replace-with-cc-token
CKFF_PRIMARY_BASE_URL=https://ckffai.com/v1
CKFF_BACKUP_BASE_URL=https://aws.ckffai.com/v1
CKFF_CODEX_MODEL=gpt-5.6-sol
CKFF_PRIMARY_TIMEOUT_SECONDS=600
SOL_MAX_ROUNDS=8

# Jev controller: OpenRouter Decisions API only. Never point Jev at CKFF or Zen.
OPENROUTER_API_URL=https://openrouter.ai/api/v1
JEV_OPENROUTER_MODEL=typesafe/jev-1.13

# Optional local Bonsai endpoint used by harness-specific CLI configuration.
LOCAL_MODEL_BASE_URL=http://100.79.248.88:8080/v1
LOCAL_MODEL_ID=/Users/teresaguajardo/Bonsai-demo/models/bonsai2-gguf/27B/Ternary-Bonsai-2-27B-PTQ1_0.gguf

# Hosted execution arms used by the bounded matched replay.
QWEN_API_URL=https://yolo-auto.com/v1
QWEN_API_KEY=replace-with-yolo-auto-key
QWEN_MODEL=qwen3.8-flash
OPENCODE_MODEL=yolo-auto/qwen3.8-flash
PI_MODEL=yolo-auto/qwen3.8-flash
GROK_BUILD_MODEL=grok-4.7
GROK_BUILD_MAX_TURNS=8
